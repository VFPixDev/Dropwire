BOT_TOKEN=123456789:replace_me
APP_NAME=Dropwire
MODE=polling

# Access control
# Bot owners who can change global settings and view the admin panel.
BOT_ADMIN_IDS=123456789
# Optional whitelist. Leave empty to allow all Telegram users.
TELEGRAM_USER_IDS=

# Runtime concurrency and flood protection
MAX_CONCURRENT_UPDATES=8
RATE_LIMIT_SECONDS=5
RATE_LIMIT_CHAT_SECONDS=3
RATE_LIMIT_CHAT_BURST=5

# Twitter/X
FX_BASE_URL=https://fxtwitter.com

# YouTube
YOUTUBE_API_KEY=

# Optional: richer Spotify metadata (author, duration, release date).
# Basic Spotify cards work without these credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Media
COMPRESS_MEDIA=1
MAX_MEDIA_MB=20
DOWNLOAD_DIR=/app/downloads
MAX_VIDEO_DURATION_MINUTES=20
MAX_FILE_SIZE_MB=1900
MAX_CONCURRENT_DOWNLOADS=2

# Database and download links
DATABASE_PATH=/app/data/dropwire.sqlite3
WEB_BIND_ADDRESS=127.0.0.1
WEB_PUBLIC_PORT=8080
# Required for "Download to DM" links, for example https://dropwire.example.com
WEB_BASE_URL=
DOWNLOAD_TOKEN_SECRET=
DOWNLOAD_LINK_TTL_MINUTES=60
DOWNLOAD_FILE_RETENTION_HOURS=24
MAX_ACTIVE_DOWNLOADS_PER_USER=3
MAX_LINKS_PER_MESSAGE=5
PROVIDER_RESPONSE_MAX_KB=512

# HTTP retry
RETRY_MAX_ATTEMPTS=3
RETRY_WAIT_MIN=0.5
RETRY_WAIT_MAX=4.0
RETRY_WAIT_MULTIPLIER=0.5
RETRY_STATUS_CODES=408,429

LOG_LEVEL=INFO

# Telegram API timeouts, seconds
TELEGRAM_CONNECT_TIMEOUT=15
TELEGRAM_READ_TIMEOUT=30
TELEGRAM_WRITE_TIMEOUT=60
TELEGRAM_POOL_TIMEOUT=15
